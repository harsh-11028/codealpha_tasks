# ============================================================
# Speech Emotion Recognition — Backend Environment Variables
# ============================================================

APP_ENV=development
APP_NAME="Speech Emotion Recognition"
APP_VERSION=1.0.0
SECRET_KEY=dev_secret_key_change_in_production_please

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_RELOAD=true

DATABASE_URL=sqlite:///./speech_emotion.db

MODEL_PATH=saved_models/best_model.pt
ACTIVE_MODEL=best
USE_GPU=false
BATCH_SIZE=32
MAX_AUDIO_DURATION=30
MAX_UPLOAD_SIZE_MB=50

AUDIO_SAMPLE_RATE=22050
AUDIO_CHUNK_DURATION=3
AUDIO_N_MFCC=40
AUDIO_N_MELS=128
AUDIO_HOP_LENGTH=512
AUDIO_N_FFT=2048

RAVDESS_PATH=dataset/raw/RAVDESS
TESS_PATH=dataset/raw/TESS
SAVEE_PATH=dataset/raw/SAVEE
CREMA_D_PATH=dataset/raw/CREMA-D
EMO_DB_PATH=dataset/raw/EMO-DB

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

HF_MODEL_NAME=facebook/wav2vec2-base
