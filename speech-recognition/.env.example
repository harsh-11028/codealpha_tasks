# ============================================================
# Speech Emotion Recognition — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ---- Application ----
APP_ENV=development                        # development | production
APP_NAME="Speech Emotion Recognition"
APP_VERSION=1.0.0
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars

# ---- Backend API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_RELOAD=true                        # Set false in production

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://localhost:8001
VITE_APP_NAME="SpeechEmo"

# ---- Database ----
DATABASE_URL=sqlite:///./speech_emotion.db  # SQLite for dev
# DATABASE_URL=postgresql://user:password@localhost:5432/speech_emotion  # Postgres for prod

# ---- ML Model ----
MODEL_PATH=backend/saved_models/best_model.pt
ACTIVE_MODEL=best                           # best | cnn | cnn_lstm | bilstm | cnn_attention | wav2vec2
USE_GPU=false                               # Set true if CUDA available
BATCH_SIZE=32
SAMPLE_RATE=22050
MAX_AUDIO_DURATION=30                       # seconds
MAX_UPLOAD_SIZE_MB=50

# ---- Audio ----
AUDIO_SAMPLE_RATE=22050
AUDIO_CHUNK_DURATION=3                      # seconds for live streaming chunks
AUDIO_N_MFCC=40
AUDIO_N_MELS=128
AUDIO_HOP_LENGTH=512
AUDIO_N_FFT=2048

# ---- Dataset Paths (optional — only needed for training) ----
RAVDESS_PATH=backend/dataset/raw/RAVDESS
TESS_PATH=backend/dataset/raw/TESS
SAVEE_PATH=backend/dataset/raw/SAVEE
CREMA_D_PATH=backend/dataset/raw/CREMA-D
EMO_DB_PATH=backend/dataset/raw/EMO-DB

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ---- Redis (optional, for caching) ----
REDIS_URL=redis://localhost:6379/0

# ---- HuggingFace (for Wav2Vec2 download) ----
HF_MODEL_NAME=facebook/wav2vec2-base
