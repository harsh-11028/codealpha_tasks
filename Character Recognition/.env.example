# =============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ----- Application -----
APP_NAME="AI Handwritten OCR System"
APP_VERSION="1.0.0"
APP_ENV="development"           # development | production
DEBUG=true

# ----- FastAPI Server -----
API_HOST="0.0.0.0"
API_PORT=8000
API_RELOAD=true                 # Set false in production
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ----- Database -----
DATABASE_URL="sqlite:///./ocr_system.db"
# For PostgreSQL (Phase 7+):
# DATABASE_URL="postgresql://user:password@localhost:5432/ocr_db"

# ----- File Upload -----
UPLOAD_DIR="backend/uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS="jpg,jpeg,png,bmp,tiff,webp"

# ----- ML Models -----
MODELS_DIR="models/saved_models"
DEFAULT_MODEL="crnn"            # cnn_basic | cnn_batchnorm | residual_cnn | crnn | vit
DEVICE="auto"                   # auto | cpu | cuda | mps

# ----- OCR Engines -----
EASYOCR_ENABLED=true
TESSERACT_ENABLED=true
CUSTOM_MODEL_ENABLED=true
EASYOCR_LANGUAGES="en"

# ----- Training -----
DATASET_DIR="models/datasets"
BATCH_SIZE=64
NUM_EPOCHS=50
LEARNING_RATE=0.001
NUM_WORKERS=4
EARLY_STOPPING_PATIENCE=7

# ----- TensorBoard -----
TENSORBOARD_LOG_DIR="tensorboard_logs"

# ----- Security -----
SECRET_KEY="change-this-to-a-random-secret-key-in-production"
RATE_LIMIT_REQUESTS=100         # requests per minute per IP

# ----- IAM Dataset (optional) -----
IAM_USERNAME=""
IAM_PASSWORD=""
