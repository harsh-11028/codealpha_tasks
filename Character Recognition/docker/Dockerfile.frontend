# Stage 1: Build React TypeScript static bundle
FROM node:20-alpine as build

WORKDIR /app

# Copy package descriptors and install cleanly
COPY frontend/package*.json ./
RUN npm ci --quiet || npm install

# Copy frontend application code and compile production bundle via Vite
COPY frontend/ .
RUN npm run build

# Stage 2: Serve optimized assets with Nginx
FROM nginx:alpine as runtime

# Remove default nginx contents and transfer build artifact from stage 1
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html

# Custom minimal Nginx configuration supporting SPA client routing and API reverse proxy
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://backend:8000/api/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
